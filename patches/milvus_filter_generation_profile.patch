From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@local>
Date: Sat, 6 Jun 2026 00:00:00 +0900
Subject: [PATCH] Profile Milvus filter bitset generation

This scaffold targets Milvus master as inspected on 2026-06-06. It instruments
the most likely scalar predicate -> filter bitset materialization path:

  internal/core/src/exec/operator/FilterBitsNode.cpp

The profile is guarded by MILVUS_FILTER_PROFILE=1 and appends CSV rows to:

  /tmp/milvus_filter_profile.csv

TODO:
- Verify TargetBitmap/TargetBitmapView count() availability on the exact Milvus
  checkout used on the server. If count() is not available, replace it with the
  local bitmap cardinality helper used elsewhere in that checkout.
- This patch uses QueryContext::query_id() when available and falls back to a
  monotonic atomic id. Join with search logs by profile_id when query_id is
  populated; otherwise join by timestamp/window and segment/predicate.

diff --git a/internal/core/src/exec/operator/FilterBitsNode.h b/internal/core/src/exec/operator/FilterBitsNode.h
index 8c8fdbb464e..0000000000 100644
--- a/internal/core/src/exec/operator/FilterBitsNode.h
+++ b/internal/core/src/exec/operator/FilterBitsNode.h
@@ -77,6 +77,8 @@ class PhyFilterBitsNode : public Operator {
     // Cache backend is the process-level ExprResCacheManager.
     bool enable_expr_cache_ = false;
     std::string expr_cache_key_;
+    // Human-readable predicate string for optional profiling logs.
+    std::string filter_profile_predicate_;
 };
 }  // namespace exec
 }  // namespace milvus
diff --git a/internal/core/src/exec/operator/FilterBitsNode.cpp b/internal/core/src/exec/operator/FilterBitsNode.cpp
index 0090d93cdd..0000000000 100644
--- a/internal/core/src/exec/operator/FilterBitsNode.cpp
+++ b/internal/core/src/exec/operator/FilterBitsNode.cpp
@@ -16,8 +16,13 @@
 #include "FilterBitsNode.h"
 
 #include <algorithm>
+#include <atomic>
 #include <chrono>
+#include <cstdlib>
+#include <fstream>
+#include <mutex>
 #include <ratio>
+#include <sstream>
 #include <utility>
 #include <vector>
 
@@ -34,6 +40,95 @@ namespace exec {
 
 namespace {
 
+std::atomic<uint64_t> g_filter_profile_id{0};
+std::mutex g_filter_profile_mu;
+
+bool
+FilterProfileEnabled() {
+    const char* value = std::getenv("MILVUS_FILTER_PROFILE");
+    return value != nullptr && std::string(value) == "1";
+}
+
+int64_t
+UnixMicros() {
+    return std::chrono::duration_cast<std::chrono::microseconds>(
+               std::chrono::system_clock::now().time_since_epoch())
+        .count();
+}
+
+std::string
+CsvEscape(const std::string& input) {
+    std::string out;
+    out.reserve(input.size() + 2);
+    out.push_back('"');
+    for (char c : input) {
+        if (c == '"') {
+            out.push_back('"');
+        }
+        out.push_back(c);
+    }
+    out.push_back('"');
+    return out;
+}
+
+std::string
+BuildProfileId(QueryContext* query_context) {
+    if (query_context != nullptr) {
+        auto query_id = query_context->query_id();
+        if (!query_id.empty()) {
+            return query_id;
+        }
+    }
+    return std::to_string(g_filter_profile_id.fetch_add(1));
+}
+
+int64_t
+SegmentId(QueryContext* query_context) {
+    auto* segment = query_context != nullptr ? query_context->get_segment()
+                                             : nullptr;
+    return segment != nullptr ? segment->get_segment_id() : -1;
+}
+
+int64_t
+MatchedCountFromExclusionBitmap(const TargetBitmap& bitset,
+                                int64_t segment_rows) {
+    // Milvus BitsetView uses set bits as filtered-out rows in vector search.
+    // FilterBitsNode flips predicate matches before returning, so matched
+    // rows are segment_rows - filtered_out_rows.
+    // TODO: adjust if the exact server checkout uses a different bitmap API.
+    return segment_rows - static_cast<int64_t>(bitset.count());
+}
+
+int64_t
+MatchedCountFromExclusionView(const TargetBitmapView& view,
+                              int64_t segment_rows) {
+    // TODO: replace view.count() if TargetBitmapView lacks count() in the
+    // target Milvus checkout.
+    return segment_rows - static_cast<int64_t>(view.count());
+}
+
+void
+AppendFilterProfileRow(QueryContext* query_context,
+                       const std::string& predicate_string,
+                       int64_t segment_rows,
+                       double filter_gen_us,
+                       size_t bitset_bytes,
+                       int64_t matched_count) {
+    if (!FilterProfileEnabled()) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(g_filter_profile_mu);
+    std::ofstream out("/tmp/milvus_filter_profile.csv", std::ios::app);
+    out << UnixMicros() << ','
+        << CsvEscape(BuildProfileId(query_context)) << ','
+        << SegmentId(query_context) << ','
+        << CsvEscape(predicate_string) << ','
+        << segment_rows << ','
+        << static_cast<int64_t>(filter_gen_us) << ','
+        << bitset_bytes << ','
+        << matched_count << '\n';
+}
+
 std::string
 BuildExprCacheKey(const plan::FilterBitsNode& filter,
                   QueryContext* query_context) {
@@ -66,7 +156,8 @@ PhyFilterBitsNode::PhyFilterBitsNode(
     enable_expr_cache_ = query_context_->get_enable_expr_cache();
     if (enable_expr_cache_) {
         expr_cache_key_ = BuildExprCacheKey(*filter, query_context_);
     }
+    filter_profile_predicate_ = filter->ToString();
 }
 
 void
@@ -153,6 +244,13 @@ PhyFilterBitsNode::GetOutput() {
         milvus::monitor::internal_core_search_latency_scalar.Observe(
             scalar_cost / 1000);
 
+        AppendFilterProfileRow(
+            query_context_,
+            filter_profile_predicate_,
+            need_process_rows_,
+            scalar_cost,
+            (col_vec_size + 7) / 8,
+            MatchedCountFromExclusionView(view, need_process_rows_));
         return std::make_shared<RowVector>(col_res);
     }
 
@@ -218,6 +316,10 @@ PhyFilterBitsNode::GetOutput() {
         ExprResCacheManager::Instance().Put(key, v);
     }
 
+    const size_t profile_bitset_bytes = (bitset.size() + 7) / 8;
+    const int64_t profile_matched_count =
+        MatchedCountFromExclusionBitmap(bitset, need_process_rows_);
+
     // num_processed_rows_ = need_process_rows_;
     std::vector<VectorPtr> col_res;
     col_res.push_back(std::make_shared<ColumnVector>(std::move(bitset),
@@ -229,5 +331,12 @@ PhyFilterBitsNode::GetOutput() {
     milvus::monitor::internal_core_search_latency_scalar.Observe(scalar_cost /
                                                                  1000);
 
+    AppendFilterProfileRow(
+        query_context_,
+        filter_profile_predicate_,
+        need_process_rows_,
+        scalar_cost,
+        profile_bitset_bytes,
+        profile_matched_count);
     return std::make_shared<RowVector>(col_res);
 }
